# /srv/twabibu/.env on the PRODUCTION server (chmod 600, owner deploy). Never commit the real file.
# Generate secrets with: openssl rand -hex 32
APP_ENV=production
APP_URL=https://twabibu.km
ADMIN_URL=https://admin.twabibu.km
SITE_DOMAIN=twabibu.km
ADMIN_DOMAIN=admin.twabibu.km
# Back-office: office address(es) only, space-separated (e.g. 41.223.10.20/32 2001:db8::/48).
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0
# acme while the DNS record is « DNS only », origin once Cloudflare proxies (certs/origin.pem + origin.key).
TLS_MODE=acme

# Images (written by scripts/deploy.sh)
REGISTRY=ghcr.io/soudaysse-ia
TAG=v0.1.0

POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
# Pepper for sign-in codes, and key for medical free text (AES-256-GCM).
# ENCRYPTION_KEY can NEVER change without re-encrypting the data: keep a copy in the password manager.
SESSION_SECRET=change-me-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

DEFAULT_TIMEZONE=Indian/Comoro
# E-mail carries the sign-in codes (ADR-016): a real provider is required in production.
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=change-me
EMAIL_FROM=Twabibu <rendez-vous@twabibu.km>
# Contact-form messages (WEB-02)
SUPPORT_EMAIL=support@twabibu.km
# SMS: fallback for patients registered by the practice without an e-mail address. fake = only logged.
# twilio: SMS_ACCOUNT_SID (AC…) + SMS_API_KEY (auth token). infobip: SMS_BASE_URL (xxxxx.api.infobip.com) + SMS_API_KEY.
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_BASE_URL=
SMS_FROM=Twabibu

# Search engines (robots.txt): true only at the public launch, once the legal texts are validated (LEGAL-01).
ALLOW_INDEXING=false

# Off-site backups (optional but strongly advised): rclone remote and age public key.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=

# Alerts from scripts/watch.sh (every 5 min): a private ntfy topic (https://ntfy.sh/<long-random-topic>) and/or
# an e-mail address (sent through Brevo). See runbooks/mise-en-production-hetzner.md §9.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
