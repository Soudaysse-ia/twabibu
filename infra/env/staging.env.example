# /srv/twabibu/.env on the STAGING server = hosted demo (ADR-020). Fictional data only, code 000000.
APP_ENV=staging
APP_URL=https://staging.twabibu.km
ADMIN_URL=https://admin.staging.twabibu.km
SITE_DOMAIN=staging.twabibu.km
ADMIN_DOMAIN=admin.staging.twabibu.km
# No demo back-office account here (ADR-020): create real ones with admin:create. Keep the back-office to your addresses.
ADMIN_ALLOWED_IPS=127.0.0.1/32
TLS_MODE=acme

REGISTRY=ghcr.io/soudaysse-ia
TAG=staging

POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
SESSION_SECRET=change-me-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

DEFAULT_TIMEZONE=Indian/Comoro
# Nothing leaves the server: codes are always 000000.
EMAIL_PROVIDER=fake
SUPPORT_EMAIL=support@twabibu.km
SMS_PROVIDER=fake
# The demo is never indexed by search engines.
ALLOW_INDEXING=false

BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=

# Alerts from scripts/watch.sh (every 5 min): a private ntfy topic (https://ntfy.sh/<long-random-topic>) and/or
# an e-mail address (sent through Brevo). See runbooks/mise-en-production-hetzner.md §9.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
