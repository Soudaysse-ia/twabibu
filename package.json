{
  "name": "twabibu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @twabibu/api db:migrate",
    "db:deploy": "pnpm --filter @twabibu/api db:deploy",
    "db:seed": "pnpm --filter @twabibu/api db:seed",
    "db:studio": "pnpm --filter @twabibu/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
