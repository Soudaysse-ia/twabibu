# Copier vers .env (racine) puis adapter. Ne jamais commiter .env.
NODE_ENV=development
# local | staging (démo hébergée : faux envois autorisés) | production (ADR-020)
APP_ENV=local
APP_URL=http://localhost:3100
# Back-office : les écritures venant d’une autre origine que APP_URL et ADMIN_URL sont refusées (SEC-03)
ADMIN_URL=http://localhost:3200
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_TIMEZONE=Indian/Comoro

# PostgreSQL 16 (Homebrew local ou docker compose)
DATABASE_URL=postgresql://<utilisateur>@localhost:5432/twabibu_prime_dev
# Redis 7+
REDIS_URL=redis://localhost:6379

# Auth (à générer : openssl rand -base64 48)
SESSION_SECRET=dev-only-session-secret-change-me
ENCRYPTION_KEY=dev-only-encryption-key-change-me

# E-mail (canal principal, ADR-016) : fake | brevo (recommandé) | resend
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_FROM=Twabibu <rendez-vous@twabibu.km>
# SMS (secondaire : patients du cabinet sans e-mail) : fake | twilio | infobip | local
SMS_PROVIDER=fake

# Stockage objet (MinIO en local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=twabibu-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Version de démonstration (page /demo, bandeau, comptes de démo sur les pages de connexion).
# Lue au build du site : NEXT_PUBLIC_DEMO_MODE=true pnpm --filter @twabibu/web build. Jamais en production.
# Exige EMAIL_PROVIDER=fake et SMS_PROVIDER=fake (code 000000).
NEXT_PUBLIC_DEMO_MODE=false

# Observabilité (vide en dev)
SENTRY_DSN=
